{
  "manifestVersion": 2,
  "publisher": "haohex",
  "author": "haohex（基于 Ming-321/CPR-key-reset-follow 二次修改）",
  "name": "key-reset-follow",
  "displayName": "拼车一体化管理插件",
  "version": "0.3.0",
  "description": "确认账号新周期后同步清零关联 Key 日、周用量，重置后可通过 SMTP 发送邮件通知；成员可在拼车页查看占比并使用日限重置卡",
  "license": "Apache-2.0",
  "engines": {"codex-proxy-rs": ">=3.35.0, <3.36.0"},
  "runtime": "trustedProcess",
  "main": "bin/key-reset-follow",
  "contributes": {"management": {"version": 2}, "maintenance": {"version": 1}, "middleware": {"version": 6, "stages": ["http"]}},
  "resources": {"web/index.html": "text/html", "web/app.js": "text/javascript", "web/app.css": "text/css", "web/carpool/index.html": "text/html", "web/carpool/carpool.js": "text/javascript", "web/carpool/carpool.css": "text/css"},
  "state": [{"namespace": "follow", "schemaVersion": 1, "schema": {"type": "object"}, "maximumRecords": 1, "maximumBytes": 262144, "maximumValueBytes": 262144}]
}
